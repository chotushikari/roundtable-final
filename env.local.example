# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Public URL reachable by Agora's cloud custom-LLM callback.
# Vercel supplies its production URL automatically. Use this only for local HTTPS tunnels.
APP_BASE_URL=

# Optional, server-only Gradium key and stable delivery voice. The interview
# uses one physical Agora agent, so it keeps this voice for the whole call.
# GRADIUM_TTS_VOICE_ID takes precedence; the Hiring Manager voice is a
# convenient default when the five role IDs are already configured.
GRADIUM_API_KEY=
GRADIUM_TTS_VOICE_ID=
GRADIUM_HIRING_MANAGER_VOICE_ID=
GRADIUM_TECHNICAL_VOICE_ID=
GRADIUM_PRODUCT_VOICE_ID=
GRADIUM_CUSTOMER_VOICE_ID=
GRADIUM_BEHAVIORAL_VOICE_ID=

# Optional, server-only Sarvam fallback. When neither Gradium nor Sarvam is
# configured, MiniMax remains the startup fallback.
SARVAM_API_KEY=
SARVAM_TTS_VOICE=anushka

# Optional, server-only Protoface Generic Avatar credentials. The visual
# publisher stays disabled until explicitly enabled so it cannot affect voice.
# Never put this value in a NEXT_PUBLIC variable or source control.
PROTOFACE_API_KEY=
PROTOFACE_AVATAR_ID=av_stock_140
ENABLE_PROTOFACE_AVATAR=false
# Optional override; the official Protoface Agora endpoint is the default.
PROTOFACE_AGORA_BASE_URL=https://api.protoface.com/v1/agora/

# Enables the bounded one-question Agora voice sample on the production homepage.
# The sample uses the legacy token/start/stop boundary but has a fixed prompt and 20-second idle timeout.
ENABLE_HOMEPAGE_VOICE_DEMO=false

# Groq powers interview planning, all-role evaluation, speaking, and assessment.
GROQ_API_KEY=
GROQ_EVALUATOR_MODEL=openai/gpt-oss-20b
GROQ_SPEAKER_MODEL=openai/gpt-oss-20b
GROQ_PLANNER_MODEL=openai/gpt-oss-20b
GROQ_ASSESSMENT_MODEL=openai/gpt-oss-20b

# Optional, server-only Gemini key for the candidate-consented temporary camera check.
# The raw clip is not stored and the result is human-review-only.
GOOGLE_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.7-flash

# Supabase: publishable values may be exposed to the browser; the secret key may not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional local testing mode; disables company email authentication.
# Never enable this in production.
NEXT_PUBLIC_DEMO_MODE=false

# Submission/demo only. Makes the company dashboard public while keeping
# Supabase persistence enabled. Never enable this for a real hiring deployment.
NEXT_PUBLIC_DISABLE_COMPANY_AUTH=false
# Optional fixed organization UUID used by the public company dashboard.
# PUBLIC_DEMO_ORGANIZATION_ID=00000000-0000-4000-8000-000000000002

# Optional company label used only by the process-local demo store.
DEMO_COMPANY_NAME=Demo Company

# Signs short-lived candidate cookies and session-scoped MCP grants.
SESSION_SIGNING_SECRET=

# Optional in local development; required when the MCP run_code_tests tool is enabled.
E2B_API_KEY=

# Optional shared secret for Agora webhook delivery.
AGORA_WEBHOOK_SECRET=

# Authenticates the daily Vercel retention job.
CRON_SECRET=
